# Environment & Secrets
.env
ota_keys.env
deployments/k8s/base/secrets.env
deployments/k8s/overlays/dev/certs/*
certs/*

# Binaries & Executables
*.exe
*.bin
cmd/gen-certs/gen-certs
cmd/ota-keygen/ota-keygen
helm.exe

# Firmware images are build artifacts, but the OTA upload tests need a real
# binary on disk so the ARGUSVER: scan runs against a file rather than only
# against bytes the test assembles itself.
!services/core-service/internal/domain/ota/testdata/*.bin

# Node & Build Outputs
node_modules/
dist/
*.tsbuildinfo
sdk_tests/build/

# Data & Models
data/*
models/*
sdk_tests/third_party/
sdk_tests/bootstrap/device.env
sdk_tests/bootstrap/device_id.txt
sdk_tests/bootstrap/workspace_id.txt

# Generated Files & Configs
base.yaml
dev.yaml
register.json
login.json
helm.zip
helm-extracted/
NUL

# IDEs & Tooling
.claude/
.opencode/
.hermes/
.vscode

# Specific Code Files
argus_esp32.cpp
firmware_v1.cpp
firmware_v2.cpp
vite.config.js
vite.config.d.ts
run_benchmark.ps1
*.py

# Scratch Arduino sketches. Test files themselves are tracked: a broad
# `*test*` rule previously ignored every *_test.go in the repo, so CI ran
# unit tests against almost nothing.
test_sketch/

